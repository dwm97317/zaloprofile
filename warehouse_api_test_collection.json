      "item": [
        {
          "name": "员工登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"0123456789\",\n  \"password\": \"123456\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/clerklogin",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "clerklogin"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.code === 1) {",
                  "        pm.environment.set('token', jsonData.data.token);",
                  "        pm.environment.set('user_id', jsonData.data.user_id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },

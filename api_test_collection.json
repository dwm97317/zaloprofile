{
  "info": {
    "name": "Zalo物流系统API测试集合",
    "description": "完整的API测试配置，包含用户管理、包裹管理、订单管理等所有主要接口",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://zalonew.itaoth.com/index.php?s=",
      "type": "string"
    },
    {
      "key": "wxapp_id",
      "value": "10001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 用户管理模块",
      "item": [
        {
          "name": "用户登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"0123456789\",\n  \"password\": \"123456\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/login",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "login"]
            }
          }
        },
        {
          "name": "用户注册",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"0123456789\",\n  \"password\": \"123456\",\n  \"code\": \"1234\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/passport/register",
              "host": ["{{base_url}}"],
              "path": ["api", "passport", "register"]
            }
          }
        },
        {
          "name": "获取用户详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user/detail?wxapp_id={{wxapp_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "detail"],
              "query": [
                {
                  "key": "wxapp_id",
                  "value": "{{wxapp_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "员工登录",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"0123456789\",\n  \"password\": \"123456\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/user/clerklogin",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "clerklogin"]
            }
          }
        }
      ]
    },
    {
      "name": "2. 包裹管理模块",
      "item": [
        {
          "name": "包裹预报",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"express_num\": \"YT1234567890\",\n  \"shop_id\": \"1\",\n  \"weight\": \"1.5\",\n  \"remark\": \"测试包裹\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/package/add",
              "host": ["{{base_url}}"],
              "path": ["api", "package", "add"]
            }
          }
        },
        {
          "name": "包裹列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/package/packagelist?wxapp_id={{wxapp_id}}&page=1",
              "host": ["{{base_url}}"],
              "path": ["api", "package", "packagelist"],
              "query": [
                {
                  "key": "wxapp_id",
                  "value": "{{wxapp_id}}"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            }
          }
        },
        {
          "name": "包裹详情",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/package/detail?id=1&wxapp_id={{wxapp_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "package", "detail"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                },
                {
                  "key": "wxapp_id",
                  "value": "{{wxapp_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "申请打包",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"package_ids\": [1, 2, 3],\n  \"address_id\": \"1\",\n  \"line_id\": \"1\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/package/inpack",
              "host": ["{{base_url}}"],
              "path": ["api", "package", "inpack"]
            }
          }
        }
      ]
    },
    {

          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": \"1\",\n  \"name\": \"Nguyen Van B\",\n  \"phone\": \"0987654321\",\n  \"country\": \"Việt Nam\",\n  \"province\": \"Hồ Chí Minh\",\n  \"city\": \"Quận 3\",\n  \"region\": \"Phường 1\",\n  \"detail\": \"456 Lê Văn Sỹ\",\n  \"userstree\": \"456 Lê Văn Sỹ, Phường 1\",\n  \"door\": \"456\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/address/edit",
              "host": ["{{base_url}}"],
              "path": ["api", "address", "edit"]

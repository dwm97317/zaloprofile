                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"address_id\": \"1\",\n  \"wxapp_id\": \"{{wxapp_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/address/remove",
              "host": ["{{base_url}}"],
              "path": ["api", "address", "remove"]
            }
          }
        },
        {
          "name": "越南地址自动补全",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/goong-address/autocomplete?input=123 Nguyen Hue&wxapp_id={{wxapp_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "goong-address", "autocomplete"],
              "query": [
                {
                  "key": "input",
                  "value": "123 Nguyen Hue"
                },
                {
                  "key": "wxapp_id",
                  "value": "{{wxapp_id}}"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. 文件上传模块",
      "item": [
        {
          "name": "图片上传",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "token",
                "value": "{{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "wxapp_id",
                  "value": "{{wxapp_id}}",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/upload/image",
              "host": ["{{base_url}}"],
              "path": ["api", "upload", "image"]
